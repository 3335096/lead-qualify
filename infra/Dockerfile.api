FROM node:22-alpine AS base
WORKDIR /app

RUN corepack enable

COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/bot-core/package.json packages/bot-core/package.json

RUN pnpm install --frozen-lockfile=false

COPY . .

RUN pnpm --filter @lead/bot-core build \
  && pnpm --filter @apps/api exec prisma generate --schema prisma/schema.prisma \
  && pnpm --filter @apps/api build

EXPOSE 3001
CMD ["pnpm", "--filter", "@apps/api", "start"]
